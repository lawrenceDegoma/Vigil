# Vigil environment template. Copy to `.env` and fill in real values locally.
# `.env` is gitignored. Never commit real credentials, phone numbers, or tokens.

# --- Edge device (services/edge) ---
VIGIL_CONFIG=config/vigil.example.toml
VIGIL_DEVICE_ID=dev-mac-01
VIGIL_LOG_LEVEL=INFO
# Directory for local recordings/outbox on the device (bounded by retention settings).
VIGIL_DATA_DIR=./data

# --- Cloud (Phase 3; not used yet) ---
SUPABASE_URL=https://your-project.supabase.co
# Anon key is safe for the browser; the service-role key is server-only.
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only
# Per-device credential issued during provisioning (Phase 3).
VIGIL_DEVICE_TOKEN=replace-me

# --- Notifications (Phase 3; server-only, never in client code) ---
# mock | twilio. Development must use `mock`; live sending requires owner approval.
VIGIL_SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15555550100
