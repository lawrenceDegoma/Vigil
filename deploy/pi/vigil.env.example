# /etc/vigil/vigil.env — environment for vigil-edge.service (mode 0640, root:vigil).
# Secrets added in Phase 3 (device token) go here, never in the TOML config or git.
VIGIL_DEVICE_ID=pi-livingroom
VIGIL_DATA_DIR=/var/lib/vigil
VIGIL_LOG_LEVEL=INFO
# Phase 3 cloud sync (only used when [cloud] enabled = true). Issued per device; never commit it.
# VIGIL_DEVICE_TOKEN=vgl_...
